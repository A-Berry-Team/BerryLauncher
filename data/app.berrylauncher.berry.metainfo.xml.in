    <screenshot>
      <image type="source" width="1202" height="698">https://raw.githubusercontent.com/A-Berry-Team/BerryLauncher/refs/heads/main/docs/images/all-runners-details.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="violence-fantasy" />
  <branding>
    <color type="primary" scheme_preference="light">#a65ad9</color>
    <color type="primary" scheme_preference="dark">#c58bea</color>
  </branding>
  <releases>
    <release version="1.0.0" date="2026-11-01" type="stable">
      <url type="details">https://github.com/A-Berry-Team/BerryLauncher/releases/tag/v1.0.0</url>
      <description>
        <p>Initial release of the launcher</p>
        <p xml:lang="es">Lanzamiento inicial del lanzador</p>
      </description>
    </release>
  </releases>
</component>
