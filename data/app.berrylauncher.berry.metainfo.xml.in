    <screenshot>
      <image type="source" width="1202" height="698">https://raw.githubusercontent.com/A-Berry-Team/BerryLauncher/refs/heads/main/docs/images/game-details.png</image>
    </screenshot>
    <screenshot>
      <image type="source" width="1202" height="698">https://raw.githubusercontent.com/A-Berry-Team/BerryLauncher/refs/heads/main/docs/images/game-download-details.png</image>
    </screenshot>
    <screenshot>
      <image type="source" width="1202" height="698">https://raw.githubusercontent.com/A-Berry-Team/BerryLauncher/refs/heads/main/docs/images/game-settings.png</image>
    </screenshot>
    <screenshot>
      <image type="source" width="1202" height="698">https://raw.githubusercontent.com/A-Berry-Team/BerryLauncher/refs/heads/main/docs/images/games-page.png</image>
    </screenshot>
    <screenshot>
      <image type="source" width="1202" height="698">https://raw.githubusercontent.com/A-Berry-Team/BerryLauncher/refs/heads/main/docs/images/launcher-preferences.png</image>
